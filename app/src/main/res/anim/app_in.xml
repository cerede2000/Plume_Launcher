<?xml version="1.0" encoding="utf-8"?>
<!-- The app that opens: it fades in over the panel that grows out of its tile (see AppHero), a moment after the panel starts. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="200"
    android:fromAlpha="0"
    android:interpolator="@android:interpolator/decelerate_quad"
    android:startOffset="110"
    android:toAlpha="1" />
