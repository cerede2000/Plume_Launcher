<?xml version="1.0" encoding="utf-8"?>
<!-- Settings is listed for the Memory feature: the service taps Force stop there (see HomeOverride.stopApps). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:packageNames="com.google.android.apps.tv.launcherx,com.android.tv.settings,com.android.settings"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:description="@string/override_desc" />
